{% comment %}
  CartBoost - Cart Drawer / Cart Page Snippet
  Place this in: snippets/cart-shipping-bar.liquid
  Usage: {% render 'cart-shipping-bar', threshold: 50, style: 'slim' %}
{% endcomment %}

{% assign bar_thresh = threshold | default: 50 %}
{% assign bar_st = style | default: 'slim' %}
{% assign bar_c = color | default: '#108043' %}

<div
  class="cb-shipping-bar cb-shipping-bar--drawer cb-shipping-bar--{{ bar_st }}"
  data-cb-shipping-bar
  data-cb-threshold="{{ bar_thresh }}"
  data-cb-message="You're {amount} away from FREE shipping!"
  data-cb-success-message="🎉 You've unlocked FREE shipping!"
  data-cb-empty-message="Free shipping on orders over {amount}!"
  style="--cb-bar-color: {{ bar_c }}; --cb-bar-bg-color: #e0e0e0; --cb-text-color: #202223; --cb-bar-height: 4px;"
>
  <div class="cb-shipping-bar__container">
    <div class="cb-shipping-bar__message" role="status" aria-live="polite"></div>
    <div class="cb-shipping-bar__progress-track cb-shipping-bar__progress-track--rounded">
      <div
        class="cb-shipping-bar__progress-fill"
        role="progressbar"
        aria-valuenow="0"
        aria-valuemin="0"
        aria-valuemax="100"
        style="width: 0%;"
      ></div>
    </div>
  </div>
</div>
